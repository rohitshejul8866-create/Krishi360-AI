# Server runtime
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Data backend: sqlite (persistent local single-table DB) | dynamodb | memory
DATA_BACKEND=sqlite
SQLITE_DB_PATH=.data/krishi360.db

# Authentication mode: dev (HMAC-SHA256 Bearer sessions) | cognito
AUTH_MODE=dev
ADMIN_EMAIL=admin@krishi360.in
ADMIN_PASSCODE=

# AI providers
AI_PROVIDER=heuristic
GEMINI_API_KEY=

# AWS DynamoDB & S3 (required only when DATA_BACKEND=dynamodb)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_NAME=krishi360-dev
DYNAMODB_ENDPOINT=
UPLOAD_BUCKET_NAME=
BEDROCK_MODEL_ID=
