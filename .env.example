# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Backend & AWS Database (DynamoDB) Configuration (Server-side only)
# ---------------------------------------------------------------------------
# DATA_BACKEND: "memory" (local in-memory store) or "dynamodb" (AWS DynamoDB)
DATA_BACKEND="memory"

# AWS_REGION & DynamoDB single-table name
AWS_REGION="ap-south-1"
DYNAMODB_TABLE_NAME="krishi360-dev"

# Optional custom DynamoDB endpoint (e.g. for DynamoDB Local / LocalStack)
DYNAMODB_ENDPOINT=""

# Configure AWS credentials in AI Studio Secrets / IAM role (never commit values)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Optional AWS S3 Upload Bucket & Bedrock AI Model
UPLOAD_BUCKET_NAME=""
AI_PROVIDER="heuristic"
BEDROCK_MODEL_ID=""
AUTH_MODE="dev"

# Optional Admin Panel Credentials Override (Server-side only)
# Leave ADMIN_PASSCODE empty to use first-run inline Admin Setup in the Admin Login panel.
ADMIN_EMAIL="admin@krishi360.in"
ADMIN_PASSCODE=""

